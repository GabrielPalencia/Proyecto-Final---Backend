# Smart Citizen API
SMART_CITIZEN_BASE_URL=https://api.smartcitizen.me/v0
SMART_CITIZEN_DEVICE_ID=

# App settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# CORS_ORIGINS=["http://localhost:5173", "https://tu-app.vercel.app"]

# Caché TTL en segundos
CACHE_TTL_SECONDS=60

# Logging
LOG_LEVEL=INFO

# Máximo de horas de antigüedad aceptable para datos del sensor en predicciones en vivo
# Si el sensor lleva más de este tiempo sin publicar, /predictions/current retorna 502
MAX_DATA_AGE_HOURS=6
